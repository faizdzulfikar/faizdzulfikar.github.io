---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={p.data.title} description={p.data.description}>
  <article class="wrap">
    <header class="page-head">
      <p class="meta"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
      <h1>{p.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
