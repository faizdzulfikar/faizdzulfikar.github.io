---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Trace from '../components/Trace.astro';
import ProjectList from '../components/ProjectList.astro';
import profile from '../data/profile.json';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="hero wrap">
    <p class="meta role">{profile.title}</p>
    <h1>{profile.name}</h1>
    <Trace />
    <p class="intro">{profile.intro}</p>
  </section>

  <section class="wrap block now">
    <h2>Now</h2>
    <ul>
      {profile.now.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Selected projects</h2>
      <a class="sans more" href="/projects/">All projects</a>
    </div>
    <ProjectList items={featured} />
  </section>

  {posts.length > 0 && (
    <section class="wrap block">
      <div class="block-head">
        <h2>Recent writing</h2>
        <a class="sans more" href="/writing/">All writing</a>
      </div>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>{p.data.title}</a>
            <span class="meta">{fmt.format(p.data.date)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .hero {
    padding: 4.5rem 0 1rem;
  }

  .role {
    margin-bottom: 0.75rem;
  }

  h1 {
    margin-bottom: 1.75rem;
  }

  .intro {
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    line-height: 1.5;
    max-width: 38rem;
  }

  .block {
    padding-top: 3.5rem;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .more {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .now h2 {
    margin-bottom: 1rem;
  }

  .now ul {
    margin: 0;
    padding-left: 1.2em;
    max-width: var(--measure);
  }

  .now li::marker {
    color: var(--accent);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
  }
</style>
