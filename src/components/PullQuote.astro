---
// Editorial pull quote. Reusable on any page: <PullQuote text="..." cite="..." size="large" />
interface Props {
  text: string;
  cite?: string;
  size?: 'medium' | 'large';
  class?: string;
}
const { text, cite, size = 'medium', class: className } = Astro.props;
---
{text && (
  <figure class:list={['pull-quote', `pq-${size}`, className]}>
    <blockquote>
      <p>{text}</p>
    </blockquote>
    {cite && <figcaption>{cite}</figcaption>}
  </figure>
)}

<style>
  .pull-quote {
    margin: 0;
    position: relative;
    padding-top: 2.25rem;
    max-width: 44rem;
  }

  /* A short accent rule instead of a decorative quote mark. */
  .pull-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--accent);
  }

  blockquote {
    margin: 0;
  }

  p {
    margin: 0;
    font-family: var(--display);
    font-style: italic;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .pq-medium p {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
  }

  .pq-large p {
    font-size: clamp(2.1rem, 5.6vw, 3.75rem);
    line-height: 1.05;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
