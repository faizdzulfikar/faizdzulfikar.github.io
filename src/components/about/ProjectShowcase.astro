---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'projects'>[];
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <ul class="showcase">
    {items.map((p, i) => (
      <li class:list={[{ lead: i === 0 }]}>
        <a href={`/projects/${p.id}/`}>
          <div class="shot">
            {p.data.image
              ? <img src={p.data.image} alt={`Screenshot of ${p.data.title}`} loading="lazy" decoding="async" />
              : <span class="ph-title" aria-hidden="true">{p.data.title}</span>}
          </div>
          <p class="name">{p.data.title}</p>
          <p class="summary">{p.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .showcase {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2rem;
  }

  .lead {
    grid-column: 1 / -1;
  }

  a {
    display: block;
    text-decoration: none;
  }

  .shot {
    aspect-ratio: 16 / 10;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    overflow: hidden;
    display: grid;
    place-items: end start;
    margin-bottom: 0.9rem;
  }

  .lead .shot {
    aspect-ratio: 21 / 9;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  a:hover img {
    transform: scale(1.02);
  }

  .ph-title {
    padding: 1.1rem 1.25rem;
    font-size: clamp(1.4rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--muted);
    transition: color 0.2s;
  }

  a:hover .ph-title,
  a:hover .name {
    color: var(--accent);
  }

  .name {
    margin: 0 0 0.2rem;
    font-weight: 600;
    transition: color 0.2s;
  }

  .summary {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 34rem;
  }

  @media (max-width: 40rem) {
    .showcase {
      grid-template-columns: 1fr;
    }

    .lead .shot {
      aspect-ratio: 16 / 10;
    }
  }
</style>
