---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'projects'>[];
}
const { items } = Astro.props;
---
<ul class="projects">
  {items.map((p) => (
    <li>
      <a class="row" href={`/projects/${p.id}/`}>
        <h3>{p.data.title}</h3>
        <p class="summary">{p.data.summary}</p>
        <p class="meta">
          <span class="status">{p.data.status}</span>
          {p.data.stack.length > 0 && <span>{p.data.stack.join(', ')}</span>}
        </p>
      </a>
    </li>
  ))}
</ul>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  li {
    border-bottom: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.35rem 2.5rem;
    padding: 1.4rem 0;
    text-decoration: none;
  }

  .row:hover h3 {
    color: var(--accent);
  }

  h3 {
    grid-row: span 2;
    transition: color 0.15s;
  }

  .summary {
    margin: 0;
    max-width: 36rem;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }

  .status {
    color: var(--text);
  }

  @media (max-width: 44rem) {
    .row {
      grid-template-columns: 1fr;
    }

    h3 {
      grid-row: auto;
    }
  }
</style>
